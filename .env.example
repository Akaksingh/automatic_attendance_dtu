# ── Copy this file to `.env` and edit before first run: `cp .env.example .env` ──
# NEVER commit the real .env. It is gitignored.

# ---- Database ----
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=attendance

# ---- Security ----
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=720

# First admin account created automatically on startup if it doesn't exist.
BOOTSTRAP_ADMIN_EMAIL=admin@college.edu
BOOTSTRAP_ADMIN_PASSWORD=change-me-too

# ---- Face recognition ----
# Cosine-similarity threshold to accept an auto-match (0..1). Higher = stricter.
# 0.35 is a sane ArcFace starting point; tune against your own data.
FACE_MATCH_THRESHOLD=0.35
# Faces below this detector score are ignored as low quality.
FACE_DET_SCORE_MIN=0.5
# 'CPUExecutionProvider' or 'CUDAExecutionProvider' (needs GPU + CUDA image).
FACE_PROVIDER=CPUExecutionProvider
# InsightFace model pack. buffalo_l = best accuracy; buffalo_s = smaller/faster.
FACE_MODEL_PACK=buffalo_l

# ---- Face model cache (must match volume in docker-compose.yml) ----
# This fixes the non-root user issue: model weights go here, not /root/.insightface
INSIGHTFACE_HOME=/data/model_cache

# ---- Data retention ----
# Raw class photos are deleted this many minutes after processing.
PHOTO_RETENTION_MINUTES=120

# ---- CORS (web app origin) ----
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# ---- For production nginx TLS (profile: prod) ----
# Provision certs into nginx/certs/ with the helper script:
#   ./scripts/setup_tls.sh self-signed                     # intranet deployments
#   ./scripts/setup_tls.sh letsencrypt <domain> <email>    # public hostname; auto-renews

# ---- Anti-spoofing / liveness detection ----
# Passive heuristics are always active (no extra deps needed):
#   LIVENESS_BLUR_THRESHOLD — Laplacian variance below this => face is too blurry (photo-of-photo).
#   LIVENESS_MIN_FACE_PX    — Faces smaller than this (in px) are ignored.
LIVENESS_BLUR_THRESHOLD=60.0
LIVENESS_MIN_FACE_PX=32

# Active ONNX model (optional — leave blank to use passive-only mode):
#   Download a Silent-Face / MIniFASNet ONNX model and point this at the file.
#   e.g. https://github.com/minivision-ai/Silent-Face-Anti-Spoofing
#   LIVENESS_THRESHOLD — minimum liveness score (0-1) to accept a face as real.
LIVENESS_MODEL=
LIVENESS_THRESHOLD=0.5
