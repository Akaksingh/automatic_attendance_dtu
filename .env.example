# ── Copy this file to `.env` and edit before first run: `cp .env.example .env` ──
# NEVER commit the real .env. It is gitignored.

# ---- Database ----
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=attendance

# ---- Security ----
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=720

# First admin account created automatically on startup if it doesn't exist.
BOOTSTRAP_ADMIN_EMAIL=admin@college.edu
BOOTSTRAP_ADMIN_PASSWORD=change-me-too

# ---- Face recognition ----
# Cosine-similarity threshold to accept an auto-match (0..1). Higher = stricter.
# 0.35 is a sane ArcFace starting point; tune against your own data.
FACE_MATCH_THRESHOLD=0.35
# Faces below this detector score are ignored as low quality.
FACE_DET_SCORE_MIN=0.5
# 'CPUExecutionProvider' or 'CUDAExecutionProvider' (needs GPU + CUDA image).
FACE_PROVIDER=CPUExecutionProvider
# InsightFace model pack. buffalo_l = best accuracy; buffalo_s = smaller/faster.
FACE_MODEL_PACK=buffalo_l

# ---- Data retention ----
# Raw class photos are deleted this many minutes after processing.
# Kept briefly only so a teacher can review a disputed auto-match.
PHOTO_RETENTION_MINUTES=120

# ---- CORS (web app origin) ----
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
