# Copy to .env when you are ready to run the API locally.
DATABASE_URL=postgresql+psycopg://attendance:changeme@localhost:5432/attendance
REDIS_URL=redis://localhost:6379/0

# Generate a production value with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
# Set true only when the API is served over HTTPS.
AUTH_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@dtu.ac.in
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-running
PROFILE_PHOTO_DIR=data/profile_photos
FACE_MODEL_PACK=buffalo_l
FACE_PROVIDER=CPUExecutionProvider
FACE_DETECTION_SCORE_MIN=0.5
FACE_MATCH_THRESHOLD=0.35
MAX_PROFILE_PHOTO_BYTES=10485760
MAX_BULK_ZIP_BYTES=104857600
MAX_BULK_ZIP_FILES=5000
MAX_SESSION_PHOTOS=20
SESSION_PHOTO_DIR=data/session_photos
SESSION_PHOTO_RETENTION_DAYS=7

# local stores under DATA_DIR; use s3 for production object storage
DATA_DIR=data
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Development SMTP (MailHog/Mailpit commonly use localhost:1025).
EMAIL_ENABLED=true
EMAIL_BACKEND=smtp
EMAIL_FROM=noreply@classlens.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# Production SES option: EMAIL_BACKEND=ses and AWS credentials/role.
SES_REGION=ap-south-1
SES_CONFIGURATION_SET=
