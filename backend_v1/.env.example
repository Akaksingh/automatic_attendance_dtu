# Copy to .env when you are ready to run the API locally.
DATABASE_URL=postgresql+psycopg://attendance:changeme@localhost:5432/attendance
REDIS_URL=redis://localhost:6379/0

# Generate a production value with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
# Set true only when the API is served over HTTPS.
AUTH_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@dtu.ac.in
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-running
PROFILE_PHOTO_DIR=data/profile_photos
FACE_MODEL_PACK=buffalo_l
FACE_PROVIDER=CPUExecutionProvider
FACE_DETECTION_SCORE_MIN=0.5
FACE_MATCH_THRESHOLD=0.35
MAX_PROFILE_PHOTO_BYTES=10485760
BULK_PHOTO_ROOT=data/bulk_photos
